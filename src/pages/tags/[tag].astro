---
import Base from "@/layouts/Base.astro";
import Posts from "@/layouts/Posts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { normalizeText } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const tags = await getTaxonomy("posts", "tags");

  return tags.map((tag) => {
    return {
      params: { tag: normalizeText(tag) },
      props: { originalTag: tag }
    };
  });
}

const { tag } = Astro.params;
const { originalTag } = Astro.props;

const posts = await getSinglePage("posts");
const filterByTag = taxonomyFilter(posts, "tags", originalTag);
const sortedPosts = sortByDate(filterByTag);
---

<Base title={`Artículos sobre ${originalTag} | 9punto5`}>
  <div class="section">
    <div class="container w-full px-4 sm:px-6 md:max-w-[720px] lg:max-w-[920px] xl:max-w-[1020px] mx-auto">
      <p class="text-center text-2xl mb-4">
        Artículos con la etiqueta
      </p>
      <h1 class="h2 mb-16 text-center text-primary">{originalTag}</h1>
      <Posts posts={sortedPosts} fluid={false} />
    </div>
  </div>
</Base>
