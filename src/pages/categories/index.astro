---
import Base from "@/layouts/Base.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize, normalizeText } from "@/lib/utils/textConverter";
import { BiCategoryAlt } from "react-icons/bi";

const categories = await getTaxonomy("posts", "categories");
const sortedCategories = categories.sort((a, b) => a.localeCompare(b, 'es'));
---

<Base title={"Categories"}>
  <section class="section">
    <div class="container text-center">
      <h1 class="h2 page-heading">Categorías</h1>
      <ul class="space-x-4">
        {
          sortedCategories.map((category) => (
            <li class="inline-block">
              <a
                href={`/blog/categories/${normalizeText(category)}`}
                class="rounded-lg bg-theme-light px-4 py-2 text-dark transition hover:bg-primary hover:text-white flex items-center group"
              >
                <BiCategoryAlt className="mr-1 text-primary group-hover:text-white transition" />
                <>{category}</>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
