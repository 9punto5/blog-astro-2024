---
import { getSinglePage } from "@/lib/contentParser.astro";

// get taxonomy from frontmatter
export const getTaxonomy = async (collection: any, name: string) => {
  const singlePages = await getSinglePage(collection);
  const taxonomyPages = singlePages.map((page: any) => page.data[name]);
  let taxonomies: string[] = [];
  
  // Crear un Map para mantener un registro de las versiones únicas
  const uniqueTaxonomies = new Map();
  
  for (let i = 0; i < taxonomyPages.length; i++) {
    const categoryArray = taxonomyPages[i];
    for (let j = 0; j < categoryArray.length; j++) {
      const item = categoryArray[j];
      const lowerItem = item.toLowerCase();
      // Si no existe una versión de este item o si la versión existente tiene menos mayúsculas, actualizamos
      if (!uniqueTaxonomies.has(lowerItem) || 
          (item.match(/[A-Z]/g) || []).length > (uniqueTaxonomies.get(lowerItem).match(/[A-Z]/g) || []).length) {
        uniqueTaxonomies.set(lowerItem, item);
      }
    }
  }
  
  // Convertir el Map a array
  taxonomies = Array.from(uniqueTaxonomies.values());
  return taxonomies;
};

