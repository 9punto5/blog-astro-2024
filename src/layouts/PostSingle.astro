---
import { Image } from "astro:assets";
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify, normalizeText } from "@/lib/utils/textConverter";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

const allAuthors = await getSinglePage("authors");
const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.slug);
const { Content } = await post.render();
const { title, description, authors, categories, image, date, tags } =
  post.data;
---

<section class="section">
  <div class="container w-full px-4 sm:px-6 lg:max-w-[700px] mx-auto" style="max-width: min(100%, 800px);">
    <article class="row justify-center">
      <div class="text-left">
        {categories.length > 0 && (
  <ul class="mb-2 flex flex-wrap items-center justify-start text-muted text-sm md:text-base">
    {categories.map((category: string, i: number) => (
      <li class="inline-block">
        <a
          href={`/blog/categories/${normalizeText(category)}`}
          class="hover:text-primary font-medium text-sm md:text-base"
        >
          {humanize(category)}
          {i !== categories.length - 1 && ', '}
        </a>
      </li>
    ))}
  </ul>
)}
<h1 class="text-2xl md:text-3xl font-bold lg:text-4xl" set:html={markdownify(title)} />
        
        <ul class="flex flex-wrap items-center justify-start mt-2 mb-4 -ml-2">
          {
            tags.map((tag: string) => (
              <li class="inline-block ml-2 mt-1">
                <a
                  href={`/blog/tags/${normalizeText(tag)}`}
                  class="block rounded-md bg-theme-light px-2 py-1 font-medium text-dark text-xs hover:text-primary transition duration-300"
                >
                  #{humanize(tag)}
                </a>
              </li>
            ))
          }
        </ul>
        
        {image && (
          <Image
            src={image}
            alt={title}
            class="ml-0 my-6 rounded-lg"
            width={800}
            height={400}
            style="max-width:100%;height:auto;"
          />
        )}
        <ul class="mt-4 mb-4 flex flex-nowrap items-center justify-start text-text text-sm md:text-base md:flex-wrap">
  <li class="pr-2">
    {allAuthors
      .filter((author) => authors.includes(author.slug))
      .map((author) => (
        <a
          href={`/blog/authors/${slugify(author.slug)}`}
          class="flex items-center hover:text-primary font-medium"
        >
          {author.data.image && (
            <Image
              src={author.data.image}
              alt={author.data.title}
              height={50}
              width={50}
              class="mr-1 md:mr-2 h-5 w-5 md:h-6 md:w-6 rounded-full flex-shrink-0"
            />
          )}
          <span class="text-sm md:text-base">{author.data.title}</span>
        </a>
      ))}
  </li>

  <li class="relative px-3">
    <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-1 rounded-full bg-gray-400"></span>
    <div class="flex items-center font-medium">
      <span>{dateFormat(date)}</span>
    </div>
  </li>
</ul>




      </div>



      <div>
        <div class="content prose mb-16 text-left">
          <Content />
        </div>
        <div class="flex flex-wrap items-center justify-between">
          <Share
            className="social-share mb-4"
            title={title}
            description={description}
            slug={post.slug}
          />
        </div>
      </div>
    </article>
  </div>
</section>

<!-- similar posts -->
{
  similarPosts.length > 0 && (
    <section class="section pt-0">
      <div class="container w-full px-4 sm:px-6 lg:max-w-[700px] mx-auto" style="max-width: min(100%, 800px);">
        <h2 class="mb-8 text-center h3">
          Artículos similares
        </h2>
        <SimilarPosts posts={similarPosts.slice(0, 3)} />
      </div>
    </section>
  )
}
