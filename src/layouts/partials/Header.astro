---
import config from "@/config/config.json";
import menu from "@/config/menu.json";

export interface NavigationLink {
  name: string;
  url: string;
}

const { main, blog }: { main: NavigationLink[]; blog: NavigationLink[] } = menu;
const basePath = config.site.base_path || "";
const logoSrc = `${basePath}/images/Logo95.svg`;
const searchUrl = `${basePath}/search`;
const homeUrl = "https://9punto5.cl/#inicio";

function isExternalUrl(url: string) {
  return url.startsWith("http://") || url.startsWith("https://");
}

function isActiveLink(url: string, pathname: string) {
  if (isExternalUrl(url)) return false;
  const normalizedPath = pathname.replace(/\/$/, "") || "/";
  const normalizedUrl = url.replace(/\/$/, "") || "/";
  if (normalizedPath === normalizedUrl) return true;
  if (normalizedUrl === basePath.replace(/\/$/, "") || normalizedUrl === "/blog") {
    return normalizedPath === normalizedUrl;
  }
  return normalizedPath.startsWith(`${normalizedUrl}/`);
}

const currentPath = Astro.url.pathname;
---

<header class="site-header container-page">
  <div class="site-header__inner">
    <a class="site-header__logo" href={homeUrl} aria-label="Inicio de 9punto5">
      <img src={logoSrc} alt="9PUNTO5 Conferencia" width="166" height="77" />
    </a>

    <div class="site-header__actions">
      <nav class="site-header__nav" aria-label="Navegación del sitio">
        {
          main.map((link) => (
            <a
              href={link.url}
              class:list={[
                "site-header__nav-link",
                { "site-header__nav-link--active": isActiveLink(link.url, currentPath) },
              ]}
              data-nav-link
              data-label={link.name}
              data-placement="site_header"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="site-header__tools">
        <a
          href={searchUrl}
          class="site-header__search"
          title="Buscar"
          aria-label="Buscar en el blog"
          data-nav-link
          data-label="Buscar"
          data-placement="site_header"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 512 512"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M456.69 421.39 362.6 327.3a173.81 173.81 0 0 0 34.84-104.58C397.44 126.38 319.06 48 222.72 48S48 126.38 48 222.72s78.38 174.72 174.72 174.72A173.81 173.81 0 0 0 327.3 362.6l94.09 94.09a25 25 0 0 0 35.3-35.3zM97.92 222.72a124.8 124.8 0 1 1 124.8 124.8 124.95 124.95 0 0 1-124.8-124.8z" />
          </svg>
        </a>

        <button
          type="button"
          class="site-header__menu-button"
          aria-label="Abrir menú"
          data-menu-open
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav class="site-header__blog-nav" aria-label="Navegación del blog">
    {
      blog.map((link) => (
        <a
          href={link.url}
          class:list={[
            "site-header__blog-link",
            { "site-header__blog-link--active": isActiveLink(link.url, currentPath) },
          ]}
          data-nav-link
          data-label={link.name}
          data-placement="blog_subnav"
        >
          {link.name}
        </a>
      ))
    }
  </nav>
</header>

<div class="site-header-menu" data-mobile-menu aria-hidden="true">
  <button type="button" class="site-header-menu__overlay" aria-label="Cerrar menú" data-menu-close></button>
  <div class="site-header-menu__panel" role="dialog" aria-modal="true" aria-label="Menú">
    <div class="site-header-menu__close-row">
      <button type="button" class="site-header-menu__close" aria-label="Cerrar menú" data-menu-close>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="site-header-menu__links" aria-label="Navegación del sitio">
      {
        main.map((link) => (
          <a
            href={link.url}
            class:list={[
              "site-header-menu__link",
              { "site-header-menu__link--active": isActiveLink(link.url, currentPath) },
            ]}
            data-nav-link
            data-label={link.name}
            data-placement="mobile_menu"
            data-menu-close-link
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <nav class="site-header-menu__links site-header-menu__links--section" aria-label="Navegación del blog">
      <p class="site-header-menu__section-label">En el blog</p>
      {
        blog.map((link) => (
          <a
            href={link.url}
            class:list={[
              "site-header-menu__link",
              { "site-header-menu__link--active": isActiveLink(link.url, currentPath) },
            ]}
            data-nav-link
            data-label={link.name}
            data-placement="mobile_menu_blog"
            data-menu-close-link
          >
            {link.name}
          </a>
        ))
      }
      <a
        href={searchUrl}
        class="site-header-menu__link"
        data-nav-link
        data-label="Buscar"
        data-placement="mobile_menu_blog"
        data-menu-close-link
      >
        Buscar
      </a>
    </nav>
  </div>
</div>

<script>
  function captureNavClick(link: HTMLAnchorElement) {
    const label = link.dataset.label;
    const placement = link.dataset.placement;
    const href = link.getAttribute("href");

    if (typeof window !== "undefined" && (window as any).posthog && label) {
      (window as any).posthog.capture("nav_link_clicked", {
        label,
        placement,
        href,
      });
    }
  }

  function setMenuOpen(open: boolean) {
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!menu) return;

    menu.dataset.open = open ? "true" : "false";
    menu.setAttribute("aria-hidden", open ? "false" : "true");
    document.body.style.overflow = open ? "hidden" : "";
  }

  function handleDocumentClick(event: MouseEvent) {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const navLink = target.closest<HTMLAnchorElement>("[data-nav-link]");
    if (navLink) {
      captureNavClick(navLink);
    }

    if (target.closest("[data-menu-open]")) {
      setMenuOpen(true);
      return;
    }

    if (target.closest("[data-menu-close]") || target.closest("[data-menu-close-link]")) {
      setMenuOpen(false);
    }
  }

  function handleDocumentKeydown(event: KeyboardEvent) {
    if (event.key === "Escape") {
      setMenuOpen(false);
    }
  }

  function initSiteHeaderMenu() {
    setMenuOpen(false);
  }

  // Delegación en document: sobrevive a View Transitions que reemplazan el header.
  if (!document.documentElement.dataset.siteHeaderMenuBound) {
    document.documentElement.dataset.siteHeaderMenuBound = "true";
    document.addEventListener("click", handleDocumentClick);
    document.addEventListener("keydown", handleDocumentKeydown);
    document.addEventListener("astro:page-load", initSiteHeaderMenu);
  }

  initSiteHeaderMenu();
</script>
