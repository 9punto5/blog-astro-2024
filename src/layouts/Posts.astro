---
import { Image } from "astro:assets";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, markdownify, slugify, normalizeText, plainify } from "@/lib/utils/textConverter";
import { format } from "date-fns";
import { es } from "date-fns/locale";
// import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";
const authors = await getSinglePage("authors");
const { summary_length } = config.settings;
const { className, posts, fluid } = Astro.props;
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post: any, i: number) => (
      <div class={i === 0 && fluid != false ? "col-12" : "col-12 sm:col-6"}>
        {post.data.image && (
          <a
            href={`/blog/${post.slug}`}
            class="rounded-lg block hover:text-primary overflow-hidden group"
          >
            <Image
              class="group-hover:scale-[1.03] transition duration-300 w-full"
              src={post.data.image}
              alt={post.data.title}
              width={i === 0 ? 925 : 445}
              height={i === 0 ? 475 : 230}
            />
          </a>
        )}
        <ul class="mt-6 mb-4 flex flex-nowrap items-center justify-start text-text text-sm md:text-base md:flex-wrap">
          <li class="pr-2">
            {authors
              .filter((author) => post.data.authors.includes(author.slug))
              .map((author) => (
                <a
                  href={`/blog/authors/${author.slug}`}
                  class="flex items-center hover:text-primary font-medium"
                >
                  {author.data.image && (
                    <Image
                      src={author.data.image}
                      alt={author.data.title}
                      height={50}
                      width={50}
                      class="mr-1 md:mr-2 h-5 w-5 md:h-6 md:w-6 rounded-full flex-shrink-0"
                    />
                  )}
                  <span class="text-sm md:text-base">{author.data.title}</span>
                </a>
              ))}
          </li>
          <li class="relative px-3">
            <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-1 rounded-full bg-gray-400"></span>
            <ul>
              {post.data.categories.map((category: string, i: number) => (
                <li class="inline-block">
                  <a
                    href={`/blog/categories/${normalizeText(category)}`}
                    class="hover:text-primary font-medium text-sm md:text-base"
                  >
                    {category}
                    {i !== post.data.categories.length - 1 && ", "}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        </ul>
        <h3 class="mb-4 text-lg md:text-xl font-bold">
          <a
            href={`/blog/${post.slug}`}
            class="block hover:text-primary transition duration-300"
          >
            {post.data.title}
          </a>
        </h3>
        <div class="text-text text-base md:text-lg">
          {post.data.description}
        </div>
      </div>
    ))
  }
</div>
