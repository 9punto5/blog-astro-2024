---
import { Image } from "astro:assets";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, markdownify, slugify, normalizeText, plainify } from "@/lib/utils/textConverter";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";
const authors = await getSinglePage("authors");
const { summary_length } = config.settings;
const { className, posts, fluid } = Astro.props;
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post: any, i: number) => (
      <div class={i === 0 && fluid != false ? "col-12" : "col-12 sm:col-6"}>
        {post.data.image && (
          <a
            href={`/blog/${post.slug}`}
            class="rounded-lg block hover:text-primary overflow-hidden group"
          >
            <Image
              class="group-hover:scale-[1.03] transition duration-300 w-full"
              src={post.data.image}
              alt={post.data.title}
              width={i === 0 ? 925 : 445}
              height={i === 0 ? 475 : 230}
            />
          </a>
        )}
        <ul class="mt-6 mb-4 flex flex-wrap items-center text-text">
          <li class="mr-3">
            {authors
              .filter((author) => post.data.authors.includes(author.slug))
              .map((author) => (
                <a
                  href={`/blog/authors/${author.slug}`}
                  class="flex items-center hover:text-primary font-medium"
                >
                  {author.data.image && (
                    <Image
                      src={author.data.image}
                      alt={author.data.title}
                      height={50}
                      width={50}
                      class="mr-2 h-6 w-6 rounded-full flex-shrink-0"
                    />
                  )}
                  <span class="truncate max-w-[120px]">{author.data.title}</span>
                </a>
              ))}
          </li>
          <li class="mr-3 flex items-center flex-wrap font-medium whitespace-nowrap">
            <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600 flex-shrink-0" />
            <>{dateFormat(post.data.date)}</>
          </li>
          <li class="flex items-center flex-wrap">
            <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600 flex-shrink-0" />
            <>
              <ul>
                {post.data.categories.map((category: string, i: number) => (
                  <li class="inline-block">
                    <a
                      href={`/blog/categories/${normalizeText(category)}`}
                      class="mr-2 hover:text-primary font-medium"
                    >
                      {category}
                      {i !== post.data.categories.length - 1 && ","}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          </li>
        </ul>
        <h3 class="mb-4">
          <a
            href={`/blog/${post.slug}`}
            class="block hover:text-primary transition duration-300"
          >
            {post.data.title}
          </a>
        </h3>
        <div class="text-text">
          {post.data.description}
        </div>
      </div>
    ))
  }
</div>
